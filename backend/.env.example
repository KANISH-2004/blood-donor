# Copy this file to .env and fill in real values. Never commit .env.

ENV=development

# Postgres example (used with docker-compose):
# DATABASE_URL=postgresql://blood_donor_user:blood_donor_pass@db:5432/blood_donor_db
# SQLite example (used for quick local dev without Docker):
DATABASE_URL=sqlite:///./blood_donor.db

# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
